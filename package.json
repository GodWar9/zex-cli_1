{
  "name": "zex",
  "version": "0.1.0",
  "description": "ZEX — Autonomous AI coding agent for the terminal",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zex-cli/zex.git"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'); const paths=['node_modules/ink/package.json','packages/cli/node_modules/ink/package.json']; if(!paths.some(p=>fs.existsSync(p))){console.error('\\n⚠ node_modules incomplete — run: npm install\\n');process.exit(1)}\"",
    "dev": "bun run packages/cli/src/index.tsx",
    "start": "bun run packages/cli/src/index.tsx",
    "build": "bun build packages/cli/src/index.tsx --compile --outfile dist/zex",
    "build:ci": "node -e \"const p=process.platform; require('child_process').execSync('bun build packages/cli/src/index.tsx --compile --outfile dist/zex'+(p==='win32'?'.exe':''),{stdio:'inherit'})\"",
    "benchmark": "bun run benchmarks/run-benchmark.ts",
    "test": "node --experimental-strip-types --test test-offline.ts",
    "test:enterprise": "node --experimental-strip-types --test test-enterprise.ts",
    "test:integration": "node --experimental-strip-types --test test-integration.ts",
    "ci": "tsc --noEmit && node --experimental-strip-types --test test-offline.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:ci && npm run ci"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/dotenv": "8.2.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "dotenv": "17.4.2",
    "ink": "7.1.0",
    "react": "19.2.7",
    "react-devtools-core": "7.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/generative-ai": "0.24.0"
  }
}
