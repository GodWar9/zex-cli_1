{
  "name": "zex",
  "version": "0.1.0",
  "description": "ZEX — Autonomous AI coding agent for the terminal",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodWar9/zex-cli_1.git"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'); const paths=['node_modules/ink/package.json','packages/cli/node_modules/ink/package.json']; if(!paths.some(p=>fs.existsSync(p))){console.error('\\n⚠ node_modules incomplete — run: npm install\\n');process.exit(1)}\"",
    "dev": "bun run packages/cli/src/index.tsx",
    "start": "bun run packages/cli/src/index.tsx",
    "build": "bun build packages/cli/src/index.tsx --compile --outfile dist/zex",
    "build:ci": "node scripts/build-binary.mjs",
    "build:core": "cd packages/core && bun run build",
    "build:cli-npm": "cd packages/cli && bun run build",
    "build:packages": "npm run build:core && npm run build:cli-npm",
    "benchmark": "bun run benchmarks/run-benchmark.ts",
    "test": "node --experimental-strip-types --test test-offline.ts",
    "test:enterprise": "node --experimental-strip-types --test test-enterprise.ts",
    "test:integration": "node --experimental-strip-types --test test-integration.ts",
    "ci": "npm run typecheck && npm test && npm run test:providers && npm run test:config && npm run test:terminal-providers && npm run test:enterprise && npm run test:package",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:ci && npm run ci",
    "test:package": "node scripts/check-packages.mjs",
    "test:providers": "node --experimental-strip-types --test test-providers.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "test:config": "node --experimental-strip-types --test test-config.ts",
    "test:terminal-providers": "node --experimental-strip-types --test test-terminal-providers.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/dotenv": "8.2.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "dotenv": "17.4.2",
    "ink": "7.1.0",
    "react": "19.2.7",
    "react-devtools-core": "7.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/generative-ai": "0.24.0"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
