{
  "name": "@zex/core",
  "version": "0.1.0",
  "description": "ZEX core library — agent orchestration, LLM providers, tools, security",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./src/*"
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/generative-ai": "0.24.0",
    "@toon-format/toon": "^2.1.0",
    "dotenv": "^17.4.2",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.33.0"
  }
}